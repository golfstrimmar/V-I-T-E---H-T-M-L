form#send-form(action="#" method="post" name="send-form").send.send-form
  h2 Задать вопрос по 1С
  .send__linia.select#wal
    p Программа
    button.dropdown-button
      span 1С: Бухгалтерия 8
      input(type="hidden" name='place'  )
      svg.icon
        use(xlink:href='#chevron-down')
    ul.dropdown-list
      li.dropdown-list__item(data-value='Notes') 1С: Бухгалтерия 8
      li.dropdown-list__item(data-value='Photo') 1С: Бухгалтерия 8
      li.dropdown-list__item(data-value='Dictionary') 1С: Бухгалтерия 8
  .send__linia.input-field.text-field 
    p ИНН организации
    input#firstname(type='text' name='name' value='' placeholder='Denzel Washington')
    label.text-field__label(for='name') 6465465464654
  .send__linia.input-field.text-field 
    p Ваше имя
    input#firstname(type='text' name='name' value='' placeholder='Denzel Washington')
    label.text-field__label(for='name') *input name
  .send__linia.select#wal
    p Должность
    button.dropdown-button
      span Главный бухгалтер
      input(type="hidden" name='place'  )
      svg.icon
        use(xlink:href='#chevron-down')
    ul.dropdown-list
      li.dropdown-list__item(data-value='Notes') Главный бухгалтер
      li.dropdown-list__item(data-value='Photo') Главный бухгалтер
      li.dropdown-list__item(data-value='Dictionary') Главный бухгалтер

  .send__linia.input-field.text-field 
    p Телефон
    input#tel(type='tel' name='tel' value='' placeholder='Denzel Washington')
    label.text-field__label(for='tel') *input tel
  .send__linia.input-field.text-field 
    p Почта
    input#email(type='email' name='email' value='' placeholder='Denzel Washington')
    label.text-field__label(for='email') *input email

  .fildset-checkbox
    .form-check
      input#agree(type='checkbox' name="agree")
      label(for='agree') Я согласен на обработку Персональных данных
  p.but-wave
    button.btn.btn-success(type='submit' ) Отправить

